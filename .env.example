# ============================================================
# PME Gestion — Modèle de configuration
# Copier ce fichier en « .env » puis renseigner vos valeurs.
# Chaque section indique où la valeur sert dans l'application.
# ============================================================

# ---------- Application ----------
APP_NAME="PME Gestion"        # Nom affiché dans les journaux/serveur
APP_ENV=development           # development | production | staging
API_BASE_URL=http://localhost:3000/api
                              # URL de base de votre API REST (backend à déployer)

# ---------- Base de données MySQL 8 / MariaDB ----------
# Déployez d'abord le schéma :  mysql -u root -p < database/schema.sql
DB_HOST=localhost             # Hébergeur (ex : db mon hébergeur, IP du VPS)
DB_PORT=3306
DB_NAME=pme_gestion           # Doit correspondre au CREATE DATABASE du .sql
DB_USER=                      # Utilisateur dédié (jamais root en production)
DB_PASSWORD=                  # Mot de passe fort
DB_ROOT_PASSWORD=             # Uniquement pour l'initialisation locale

# ---------- Sécurité ----------
JWT_SECRET=                   # Clé longue et aléatoire (ex : openssl rand -hex 64)
JWT_EXPIRES_IN=7d             # Durée de validité des sessions

# ---------- Stockage fichiers ----------
STORAGE_URL=http://localhost:3000/uploads
                              # URL publique des images (logo, cachet, signatures, produits)
MAX_UPLOAD_MB=5               # Taille max des uploads

# ---------- Firebase (optionnel) ----------
# Console : https://console.firebase.google.com — sert aux notifications
# push et à l'authentification par numéro de téléphone (OTP).
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ---------- Mobile Money (phase ultérieure) ----------
# Clés API des agrégateurs officiels pour l'automatisation des transactions.
# Tant que vide : les transactions MoMo sont saisies manuellement dans l'app.
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
MOOV_MONEY_CLIENT_ID=
MOOV_MONEY_CLIENT_SECRET=
TELECEL_MONEY_CLIENT_ID=
TELECEL_MONEY_CLIENT_SECRET=

# ---------- Supabase (HÉBERGEMENT GRATUIT — voir database/SUPABASE_DEPLOIEMENT.md) ----------
# Base + API + auth + images, sans serveur. Remplir → l'app passe en mode cloud.
# Laisser vide → mode local démo (données sur l'appareil).
SUPABASE_URL=
SUPABASE_ANON_KEY=
